# Copy into a private local/deployment environment file and replace placeholders.
# Never use this example file as a source of runtime environment values.

DATABASE_URL=
DIRECT_URL=
SESSION_SECRET=
SUPER_ADMIN_EMAIL=

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_APP_NAME=Milk System
# Required in production for verification, email-change, and welcome links.
# Use the canonical public HTTPS origin, for example https://www.example.com.
NEXT_PUBLIC_APP_URL=
FRONTEND_URL=
APP_ENV=development

EMAIL_PROVIDER=resend
EMAIL_FROM=
RESEND_API_KEY=
RESEND_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# LMBTech MTN MoMo. Configure only in server-side environment storage.
LMBTECH_BASE_URL=https://pay.lmbtech.rw/pay/config/api.php
LMBTECH_APP_KEY=
LMBTECH_SECRET_KEY=
# Legacy credential aliases; canonical LMBTECH_APP_KEY / LMBTECH_SECRET_KEY take precedence.
LMBTECH_API_KEY=
LMBTECH_API_SECRET=
# Must be the deployed public URL; leave unset locally to keep real payments unavailable.
LMBTECH_CALLBACK_URL=
LMBTECH_ALLOW_REAL_PAYMENTS=false

# External scheduler authentication. Set a random secret in deployment settings.
CRON_SECRET=
# Choose approved reminder offsets (days before expiry); no business offsets are assumed.
SUBSCRIPTION_REMINDER_DAYS=

# Optional server-side OCR for notebook/list photos. Configure exactly one of the
# alternatives below. These values are server-only and must never be prefixed with
# NEXT_PUBLIC_. Leave unset to disable photo scanning; paste, CSV, Excel and text
# PDF imports continue to work.
GOOGLE_VISION_API_KEY=
GOOGLE_VISION_SERVICE_ACCOUNT_JSON=
GOOGLE_VISION_SERVICE_ACCOUNT_BASE64=
# Path to a service-account JSON file available to the server process.
GOOGLE_APPLICATION_CREDENTIALS=
